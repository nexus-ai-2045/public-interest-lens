    "preview:check": "node scripts/local-preview-check.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "gsap": "3.15.0",
    "katex": "0.18.8",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
